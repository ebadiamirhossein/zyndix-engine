# Supabase (required)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Dev-only: session-pooler URL for `pnpm gen:types`
# SUPABASE_DB_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# Cron auth (required for /api/cron/* routes)
CRON_SECRET=

# Anthropic
# ANTHROPIC_API_KEY=

# Apollo
# APOLLO_API_KEY=

# Apify
# APIFY_TOKEN=

# NeverBounce
# NEVERBOUNCE_API_KEY=

# Instantly
# INSTANTLY_API_KEY=

# Attio
# ATTIO_API_KEY=

# Calendly
# CALENDLY_WEBHOOK_SIGNING_KEY=

# Telegram
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_ALLOWED_USER_IDS=
# TELEGRAM_WEBHOOK_SECRET=

# Dashboard
# DASHBOARD_ALLOWED_EMAILS=
