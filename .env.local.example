# Supabase (required)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Dev-only: session-pooler URL for `pnpm gen:types`
# SUPABASE_DB_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# Cron auth (required for /api/cron/* routes)
CRON_SECRET=

# Anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-6
# QUALIFY_BATCH_SIZE=5
# QUALIFY_MAX_SITE_CHARS=20000
# QUALIFY_MIN_SCORE=50

# Apollo
# APOLLO_API_KEY=
# APOLLO_MAX_REVEALS_PER_RUN=5
# SOURCE_PIPELINE_CAP=50
# SOURCE_PAGE_SIZE=25

# Apify
# APIFY_TOKEN=
# APIFY_POLL_TIMEOUT_MS=300000
# ENRICH_BATCH_SIZE=10

# NeverBounce
# NEVERBOUNCE_API_KEY=

# Instantly
# INSTANTLY_API_KEY=

# Attio
# ATTIO_API_KEY=

# Calendly
# CALENDLY_WEBHOOK_SIGNING_KEY=

# Telegram
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_ALLOWED_USER_IDS=
# TELEGRAM_WEBHOOK_SECRET=

# Dashboard
# DASHBOARD_ALLOWED_EMAILS=
