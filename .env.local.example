# Supabase (required)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Dev-only: session-pooler URL for `pnpm gen:types`
# SUPABASE_DB_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# Cron auth (required for /api/cron/* routes)
CRON_SECRET=

# Anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-6
# QUALIFY_BATCH_SIZE=5
# QUALIFY_MAX_SITE_CHARS=20000
# QUALIFY_MIN_SCORE=50

# Apollo
# APOLLO_API_KEY=
# APOLLO_MAX_REVEALS_PER_RUN=5
# SOURCE_PIPELINE_CAP=50
# SOURCE_PAGE_SIZE=25

# Apify
# APIFY_TOKEN=
# APIFY_POLL_TIMEOUT_MS=300000
# ENRICH_BATCH_SIZE=10

# MillionVerifier
# MILLIONVERIFIER_API_KEY=
# VERIFY_BATCH_SIZE=5

# NeverBounce
# NEVERBOUNCE_API_KEY=

# Instantly
# INSTANTLY_API_KEY=
# Shared token Instantly sends as x-zyndix-webhook-token (no HMAC exists). >= 32 chars: openssl rand -hex 32
# INSTANTLY_WEBHOOK_SECRET=

# Attio
# ATTIO_API_KEY=

# Calendly
# CALENDLY_WEBHOOK_SIGNING_KEY=

# Telegram
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_ALLOWED_USER_IDS=
# TELEGRAM_WEBHOOK_SECRET=

# Draft stage
# DRAFT_BATCH_SIZE=5

# Dashboard (U1)
# Anon key, NOT service-role, and deliberately NOT NEXT_PUBLIC_: sign-in runs
# through a server action, so no client component ever holds a Supabase client.
# SUPABASE_ANON_KEY=
#
# Who may sign in, and the role each is provisioned with on first login.
# A bare email defaults to viewer. app_users.role is the authority afterwards,
# so changing someone's role is a DB update, not a redeploy.
# DASHBOARD_ALLOWED_EMAILS=amir@example.com:admin,ops@example.com:operator
